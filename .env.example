# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_DOMAIN=localhost:3000
APP_BASE_URL=http://localhost:3000

# Kommo API Configuration
KOMMO_URL=https://[YOUR_SUBDOMAIN].kommo.com
KOMMO_CLIENT_ID=[YOUR_CLIENT_ID]
KOMMO_CLIENT_SECRET=[YOUR_CLIENT_SECRET]
KOMMO_REDIRECT_URI=http://localhost:3000/oauth/callback
KOMMO_ACCESS_TOKEN=
KOMMO_REFRESH_TOKEN=

# Kommo Default Field Values (required for lead creation)
KOMMO_DEFAULT_PIPELINE_ID=[0000000]

# Security Configuration
WEBHOOK_SECRET=your_webhook_secret_key
STRICT_SIGNATURE_VALIDATION=true
STRICT_IP_VALIDATION=true
CORS_ORIGINS=https://formspree.io,https://submit-form.com
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Logging Configuration
LOG_LEVEL=info
